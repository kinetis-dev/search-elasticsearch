{
    "name": "kinetis/search-elasticsearch",
    "description": "Fiber-native non-blocking Elasticsearch client construction for Kinetis, on kinetis/search's Revolt-backed HTTP transport.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "kinetis/search": "dev-main",
        "elastic/transport": "^8.11 || ^9.0",
        "elasticsearch/elasticsearch": "^8.19 || ^9.0",
        "psr/container": "^2.0.2",
        "psr/http-client": "^1.0.3"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "kinetis/revolt-http-client": "dev-main",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\SearchElasticsearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\SearchElasticsearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "bootstrap": "Kinetis\\SearchElasticsearch\\PackageBootstrap"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../revolt-http-client"
        },
        {
            "type": "path",
            "url": "../framework"
        },
        {
            "type": "path",
            "url": "../search"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
